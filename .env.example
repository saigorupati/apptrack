# Copy to .env and fill in. Never commit .env.

# Gmail (IMAP read + SMTP digest). App password: Google Account -> Security ->
# 2-Step Verification -> App passwords (remove spaces).
GMAIL_ADDRESS=you@gmail.com
GMAIL_APP_PASSWORD=

# Google Sheet ID (the long token in the sheet URL between /d/ and /edit).
# Share the sheet (Editor) with the service account's client_email first.
SHEET_ID=

# Path inside the container (mounted by docker-compose from ./secrets/).
GOOGLE_SA_JSON=/secrets/service-account.json

# Local LLM fallback (any OpenAI-compatible endpoint: llama.cpp, Ollama, vLLM,
# LM Studio). Set LLM_ENABLED=0 to run rules-only with no LLM at all —
# ambiguous emails then land in NEEDS_REVIEW instead of being classified.
LLM_ENABLED=1
LLM_BASE_URL=http://llama:8080/v1
LLM_MODEL=qwen2.5-7b
# Docker network your LLM container lives on (external network name)
LLM_DOCKER_NETWORK=bridge

# Behavior
FOLLOWUP_DAYS=14
DIGEST_TO=you@gmail.com
SYNC_HOUR=2
BACKFILL_DAYS=30
DB_PATH=/data/apptrack.db
TZ=America/New_York
